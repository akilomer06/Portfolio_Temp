{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{dist/**,cms.seed.json,cms.migrations.json}",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/admin(?:/.*)?", "headers": { "X-Frame-Options": "DENY", "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "/api/(.*)", "dest": "/api/index?__route=/api/$1" },
    { "src": "/media/uploads/(.*)", "dest": "/api/index?__route=/media/uploads/$1" },
    { "src": "/", "dest": "/api/index?__route=/" },
    { "src": "/work/([a-zA-Z0-9-]+)/?", "dest": "/api/index?__route=/work/$1/" },
    { "src": "/services/([a-zA-Z0-9-]+)/?", "dest": "/api/index?__route=/services/$1/" },
    { "src": "/insights/([a-zA-Z0-9-]+)/?", "dest": "/api/index?__route=/insights/$1/" },
    { "src": "/(work|services|insights|about|contact|privacy|terms|accessibility)/?", "dest": "/api/index?__route=/$1/" },
    { "src": "/admin/?", "dest": "/admin/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
