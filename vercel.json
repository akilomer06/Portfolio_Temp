{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{dist/**,cms.seed.json,cms.migrations.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=/api/:path*" },
    { "source": "/media/uploads/:path*", "destination": "/api/index?__route=/media/uploads/:path*" },
    { "source": "/", "destination": "/api/index?__route=/" },
    { "source": "/:page(work|services|insights|about|contact)/", "destination": "/api/index?__route=/:page/" }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ]}
  ]
}
